# Copy this file to .env and fill in what you need.

# ---- Server ----
PORT=8787
# 127.0.0.1 = only this computer can open the control panel.
HOST=127.0.0.1

# ---- Brain: any OpenAI-compatible chat API. Pick ONE setup. ----
#
# A) Local and free: Ollama (https://ollama.com). Install it, then run once:
#      ollama pull qwen3:8b
#    Qwen models speak Chinese and English well. Needs a decent PC (8 GB+ VRAM is comfortable).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b
#
# B) Google Gemini, free tier. Key: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.5-flash
#
# C) Groq, free tier, very fast. Key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=llama-3.3-70b-versatile
#
# Seconds of silence in chat before she starts talking on her own. 0 = never.
IDLE_TALK_SECONDS=60

# ---- Voice (text-to-speech) ----
# edge = free Microsoft Edge voices (needs internet). mock = beeps, for testing offline.
TTS_PROVIDER=edge
# Any Edge voice name, e.g. zh-CN-XiaoyiNeural, zh-CN-XiaoxiaoNeural,
# zh-TW-HsiaoChenNeural, en-US-AnaNeural, ja-JP-NanamiNeural
TTS_VOICE=zh-CN-XiaoyiNeural
# Speed and pitch adjustments, e.g. +10% / -5% and +20Hz / -10Hz
TTS_RATE=+0%
TTS_PITCH=+0Hz

# ---- Chat sources (comma separated): console, youtube ----
CHAT_SOURCES=console

# ---- YouTube live chat ----
# API key from Google Cloud Console with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=
# The video id of your live stream (the part after watch?v=).
YOUTUBE_VIDEO_ID=
# How often to check chat. Each check costs 5 quota units; the free quota is
# 10,000 units/day, so 8 seconds lasts about 4.4 hours of streaming per day.
YOUTUBE_POLL_SECONDS=8
