# Copy this file to .env and fill in what you need.

# ---- Server ----
PORT=8787

# ---- Brain (Claude) ----
# Get a key at https://console.anthropic.com/  (required for AI replies)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fast, cheap replies (good for chat). medium/high = more thoughtful, slower.
CLAUDE_EFFORT=low
# Seconds of silence in chat before she starts talking on her own. 0 = never.
IDLE_TALK_SECONDS=60

# ---- Voice (text-to-speech) ----
# edge = free Microsoft Edge voices (needs internet). mock = beeps, for testing offline.
TTS_PROVIDER=edge
# Any Edge voice name, e.g. zh-CN-XiaoyiNeural, zh-CN-XiaoxiaoNeural,
# zh-TW-HsiaoChenNeural, en-US-AnaNeural, ja-JP-NanamiNeural
TTS_VOICE=zh-CN-XiaoyiNeural
# Speed and pitch adjustments, e.g. +10% / -5% and +20Hz / -10Hz
TTS_RATE=+0%
TTS_PITCH=+0Hz

# ---- Chat sources (comma separated): console, youtube ----
CHAT_SOURCES=console

# ---- YouTube live chat ----
# API key from Google Cloud Console with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=
# The video id of your live stream (the part after watch?v=).
YOUTUBE_VIDEO_ID=
# How often to check chat. Each check costs 5 quota units; the free quota is
# 10,000 units/day, so 8 seconds lasts about 4.4 hours of streaming per day.
YOUTUBE_POLL_SECONDS=8
