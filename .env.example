# Copy this file to .env and fill in what you need.

# ---- Server ----
PORT=8787
# 127.0.0.1 = only this computer can open the control panel.
HOST=127.0.0.1

# ---- Brain: any OpenAI-compatible chat API. Pick ONE setup. ----
#
# A) Local and free: Ollama (https://ollama.com). Install it, then run once:
#      ollama pull qwen3:8b
#    Qwen models speak Chinese and English well. Needs a decent PC (8 GB+ VRAM is comfortable).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b
#
# B) Google Gemini, free tier. Key: https://aistudio.google.com/apikey
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-2.5-flash
#
# C) Groq, free tier, very fast. Key: https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=llama-3.3-70b-versatile
#
# Seconds of silence in chat before she starts talking on her own. 0 = never.
IDLE_TALK_SECONDS=60

# ---- Voice (text-to-speech) ----
# edge       = free Microsoft Edge voices (needs internet)
# command    = a voice program on your PC, e.g. Kokoro (free, offline, British; see README)
# gpt-sovits = your own cloned voice running on your PC (set it up in config/voice.json)
# mock       = beeps, for testing offline
TTS_PROVIDER=edge
# Any Edge voice name. British: en-GB-LibbyNeural, en-GB-SoniaNeural,
# en-GB-MaisieNeural (female), en-GB-RyanNeural, en-GB-ThomasNeural (male).
# Others: zh-CN-XiaoyiNeural, zh-TW-HsiaoChenNeural, zh-HK-HiuGaaiNeural, ja-JP-NanamiNeural
TTS_VOICE=en-GB-LibbyNeural
# Speed and pitch adjustments, e.g. +10% / -5% and +20Hz / -10Hz
TTS_RATE=+0%
TTS_PITCH=+0Hz
# Second voice for narrator lines and 晝霽's lines in videos (an Edge voice).
NARRATOR_VOICE=en-GB-RyanNeural
# For TTS_PROVIDER=command: the program to run (text in on stdin, WAV out on stdout).
# TTS_COMMAND=python scripts/kokoro-tts.py
# Kokoro voices: hers (bf_emma, bf_isabella, bf_lily, bf_alice) and the narrator's
# (bm_george, bm_fable, bm_lewis, bm_daniel). 1.0 is normal speed.
# KOKORO_VOICE=bf_emma
# KOKORO_NARRATOR_VOICE=bm_george
# KOKORO_SPEED=1.0

# ---- Chat sources (comma separated): console, youtube ----
CHAT_SOURCES=console

# ---- YouTube live chat ----
# API key from Google Cloud Console with "YouTube Data API v3" enabled.
YOUTUBE_API_KEY=
# The video id of your live stream (the part after watch?v=).
YOUTUBE_VIDEO_ID=
# How often to check chat. Each check costs 5 quota units; the free quota is
# 10,000 units/day, so 8 seconds lasts about 4.4 hours of streaming per day.
YOUTUBE_POLL_SECONDS=8

# ---- Videos (npm run video) ----
# Language the AI writes video scripts in.
VIDEO_LANGUAGE=British English (UK spelling and phrasing)
# Rendering uses a hidden browser. `npm run setup` installs one; on Windows,
# Microsoft Edge is used automatically if that fails. Or point to any Chrome/Edge:
# BROWSER_PATH=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
# Set to 1 only if rendering fails on a PC without a working graphics card (much slower).
RENDER_SOFTWARE_GL=0
# ffmpeg comes with `npm install`; set this only to use a different one.
# FFMPEG_PATH=
