{
  "name": "ai-vtuber",
  "version": "0.1.0",
  "private": true,
  "description": "朝暮, an AI Live2D character: auto-written short videos (9:16 / 16:9) and live streams, with a free or local AI and voice.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup-core.mjs && playwright install chromium",
    "start": "tsx server/main.ts",
    "dev": "tsx watch --exclude './web/**' server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "video": "tsx video/make.ts"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "msedge-tts": "^2.0.8",
    "pixi.js": "^8.22.0",
    "playwright": "^1.63.0",
    "untitled-pixi-live2d-engine": "^1.4.0",
    "vite": "^8.3.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
